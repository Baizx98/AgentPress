---
import { formatDate } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { data } = post;
const href = `/posts/${post.id}/`;
---

<article class:list={['post-card', `post-card--${data.type}`]}>
  <div class="eyebrow">{data.type === 'paper' ? '论文介绍' : data.type === 'technical-report' ? '技术报告' : data.type === 'blog' ? data.series === 'daily-brief' ? '每日简报' : '博客' : '随笔'}</div>
  <h2><a href={href}>{data.title}</a></h2>
  {data.type === 'paper' && (
    <div class="paper-meta">
      <p>{data.authors.join(' · ')}</p>
      <p>{data.affiliations.join(' · ')} · {data.venue}</p>
    </div>
  )}
  <p>{data.description}</p>
  {data.type === 'technical-report' && (
    <div class="card-links">
      {data.repository && <a href={data.repository}>开源仓库 ↗</a>}
      {data.demoUrl && <a href={data.demoUrl}>在线演示 ↗</a>}
    </div>
  )}
  <div class="card-footer">
    <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
    <span>{data.tags.join(' · ')}</span>
  </div>
</article>
