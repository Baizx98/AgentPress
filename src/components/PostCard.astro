---
import { formatDate, getReadingStats } from '../lib/content';
import type { CollectionEntry } from 'astro:content';
import { contentTypes } from '../config/content';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  variant?: 'default' | 'home';
}
const { post, variant = 'default' } = Astro.props;
const { data } = post;
const href = `/posts/${post.id}/`;
const reading = getReadingStats(post.body ?? '');
const config = contentTypes[data.type];
---

<article class:list={['post-card', `post-card--${data.type}`, `post-card--${config.cardStyle}`, `post-card--${variant}`]} data-content-type={data.type} data-tags={data.tags.join('|')}>
  <div class="eyebrow">{data.type === 'paper' ? 'Paper' : data.type === 'technical-report' ? 'Report' : data.type === 'blog' ? data.series === 'daily-brief' ? 'Daily Brief' : 'Blog' : 'Note'}</div>
  <div class="post-card-main">
    <h2><a href={href}>{data.title}</a></h2>
    {data.type === 'paper' && <div class="paper-meta"><p>{data.authors.join(' · ')}</p><p>{data.affiliations.join(' · ')} · {data.venue}</p></div>}
    <p>{data.description}</p>
    <div class="card-footer">
      <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)} · {reading.count} 字 · 约 {reading.minutes} 分钟</time>
      {(data.type === 'technical-report' || data.type === 'paper') && <span class="card-links">
        {data.type === 'technical-report' && data.repository && <a href={data.repository} aria-label="开源仓库" title="开源仓库"><Icon name="external" /></a>}
        {data.type === 'technical-report' && data.demoUrl && <a href={data.demoUrl} aria-label="在线演示" title="在线演示"><Icon name="external" /></a>}
        {data.type === 'paper' && data.paperUrl && <a href={data.paperUrl} aria-label="论文链接" title="论文链接"><Icon name="external" /></a>}
      </span>}
      <span class="card-tags">{data.tags.map((tag) => <a href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</span>
    </div>
  </div>
  {variant !== 'home' && config.showCover && data.cover && <a class="post-card-cover" href={href}><img src={data.cover} alt="" loading="lazy" /></a>}
</article>
