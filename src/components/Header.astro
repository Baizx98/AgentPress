---
import { siteConfig } from '../config/site';
interface Props { classic?: boolean; }
const { classic = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--classic': classic }]}>
  {classic ? <div class="classic-nav-shell">
    <a class="classic-brand" href="/">{siteConfig.name}</a>
    <nav aria-label="主导航"><a href="/archive/">归档</a><a href="/about/">关于</a></nav>
  </div> : <div class="nav-shell">
    <a class="brand" href="/"><span class="brand-mark">{siteConfig.shortName.slice(0, 1)}</span><span>{siteConfig.name}</span></a>
    <nav aria-label="主导航">
      {siteConfig.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>}
</header>
