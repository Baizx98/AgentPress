---
import { siteConfig } from '../config/site';
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/"><span class="brand-mark">{siteConfig.shortName.slice(0, 1)}</span><span>{siteConfig.name}</span></a>
    <nav aria-label="主导航">
      {siteConfig.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
