---
import Icon from './Icon.astro';
import { themes } from '../config/theme';
---
<nav class="floating-bar" aria-label="快捷工具" data-reading-progress>
  <span class="reading-progress" aria-hidden="true"></span>
  <button type="button" data-history-back data-fallback="/" aria-label="返回" title="返回"><Icon name="back" /></button>
  <button type="button" data-search-open aria-label="搜索" title="搜索"><Icon name="search" /></button>
  <div class="dock-menu-wrap">
    <button type="button" data-theme-menu aria-label="配色方案" title="配色方案"><Icon name="palette" /></button>
    <div class="theme-menu" data-theme-panel hidden>
      {themes.map((theme) => <button type="button" data-theme-value={theme.id}>{theme.name}</button>)}
    </div>
  </div>
  <span class="dock-divider" aria-hidden="true"></span>
  <a href="/" aria-label="首页" title="首页"><Icon name="home" /></a>
  <span class="dock-divider" aria-hidden="true"></span>
  <button type="button" data-color-mode aria-label="切换深浅色" title="切换深浅色"><Icon name="theme" /></button>
  <button type="button" data-back-top aria-label="回到顶部" title="回到顶部"><Icon name="top" /></button>
</nav>

<script>
  const root = document.documentElement;
  const panel = document.querySelector<HTMLElement>('[data-theme-panel]');
  const savedTheme = localStorage.getItem('theme') ?? 'default';
  const savedMode = localStorage.getItem('color-mode');
  root.dataset.theme = savedTheme;
  if (savedMode === 'dark' || (!savedMode && matchMedia('(prefers-color-scheme: dark)').matches)) root.classList.add('dark');

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-history-back]')) history.length > 1 ? history.back() : location.assign('/');
    if (target.closest('[data-theme-menu]')) panel?.toggleAttribute('hidden');
    const value = target.closest<HTMLElement>('[data-theme-value]')?.dataset.themeValue;
    if (value) { root.dataset.theme = value; localStorage.setItem('theme', value); panel?.setAttribute('hidden', ''); }
    if (target.closest('[data-color-mode]')) { root.classList.toggle('dark'); localStorage.setItem('color-mode', root.classList.contains('dark') ? 'dark' : 'light'); }
    if (target.closest('[data-back-top]')) scrollTo({ top: 0, behavior: 'smooth' });
    if (!target.closest('.dock-menu-wrap')) panel?.setAttribute('hidden', '');
  });
  const updateProgress = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    document.querySelector<HTMLElement>('[data-reading-progress]')?.style.setProperty('--reading-progress', `${max > 0 ? Math.min(100, (scrollY / max) * 100) : 0}%`);
  };
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
  updateProgress();
</script>
