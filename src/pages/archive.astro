---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { publishedPosts, formatDate } from '../lib/content';
import { archivePageSize } from '../config/content';

const posts = await publishedPosts();
const initialPosts = posts.slice(0, archivePageSize);
const years = [...new Set(initialPosts.map((post) => post.data.publishedAt.getFullYear()))].sort((a, b) => b - a);
const totalPages = Math.ceil(posts.length / archivePageSize);
---

<BaseLayout title="归档" description="按时间浏览全部公开内容。">
  <PageHeader title="归档" description="按时间浏览全部公开内容。" />
  <div class="archive-timeline" id="archive-results" data-page-size={archivePageSize}>
    {years.map((year) => <section data-archive-year={year}>
      <div class="timeline-year">{String(year).slice(2)}</div>
      <h2>{year}</h2>
      <div class="timeline-list">
        {initialPosts.filter((post) => post.data.publishedAt.getFullYear() === year).map((post) => <a href={`/posts/${post.id}/`}>
          <time>{formatDate(post.data.publishedAt)}</time><span><strong>{post.data.title}</strong><small>{post.data.description}</small></span>
        </a>)}
      </div>
    </section>)}
  </div>
  {totalPages > 1 && <div class="archive-load-more"><button type="button" data-load-more data-next-page="2">加载更早的文章</button></div>}
</BaseLayout>

<script>
  interface ArchiveItem { slug: string; title: string; description: string; publishedAt: string; }

  const timeline = document.querySelector<HTMLElement>('#archive-results');
  const loadMore = document.querySelector<HTMLButtonElement>('[data-load-more]');
  const pageSize = Number(timeline?.dataset.pageSize ?? 30);
  const formatter = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' });

  const appendItem = (item: ArchiveItem) => {
    if (!timeline) return;
    const date = new Date(item.publishedAt);
    const year = date.getFullYear();
    let section = timeline.querySelector<HTMLElement>(`[data-archive-year="${year}"]`);
    let list: HTMLElement;
    if (!section) {
      section = document.createElement('section');
      section.dataset.archiveYear = String(year);
      const badge = document.createElement('div');
      const heading = document.createElement('h2');
      list = document.createElement('div');
      badge.className = 'timeline-year'; badge.textContent = String(year).slice(2);
      heading.textContent = String(year); list.className = 'timeline-list';
      section.append(badge, heading, list); timeline.append(section);
    } else {
      list = section.querySelector<HTMLElement>('.timeline-list')!;
    }
    const link = document.createElement('a');
    const time = document.createElement('time');
    const copy = document.createElement('span');
    const title = document.createElement('strong');
    const description = document.createElement('small');
    link.href = `/posts/${item.slug}/`;
    time.dateTime = item.publishedAt; time.textContent = formatter.format(date);
    title.textContent = item.title; description.textContent = item.description;
    copy.append(title, description); link.append(time, copy); list.append(link);
  };

  loadMore?.addEventListener('click', async () => {
    const page = Number(loadMore.dataset.nextPage);
    loadMore.disabled = true; loadMore.textContent = '正在加载…';
    try {
      const response = await fetch(`/api/content/pages/${page}.json`);
      if (!response.ok) throw new Error('Archive page unavailable');
      const payload: { items: ArchiveItem[] } = await response.json();
      payload.items.forEach(appendItem);
      if (payload.items.length < pageSize) loadMore.remove();
      else { loadMore.dataset.nextPage = String(page + 1); loadMore.disabled = false; loadMore.textContent = '加载更早的文章'; }
    } catch {
      loadMore.disabled = false; loadMore.textContent = '加载失败，点击重试';
    }
  });
</script>
