---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedPosts, formatDate } from '../lib/content';
import { contentTypes } from '../config/content';

const posts = await publishedPosts();
const types = Object.entries(contentTypes);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))].sort((a, b) => b - a);
const countType = (type: string) => posts.filter((post) => post.data.type === type).length;
const countTag = (tag: string) => posts.filter((post) => post.data.tags.includes(tag)).length;
---
<BaseLayout title="归档" description="按类型、标签和时间浏览公开内容。">
  <section class="page-header"><h1>归档</h1><p>按类型、标签和时间浏览所有公开内容。</p></section>
  <section class="archive-filters" data-archive-filter-root hidden aria-label="归档筛选">
    <fieldset><legend>类型</legend><div class="filter-chips">
      <button type="button" data-filter-kind="type" data-filter-value="" aria-pressed="true">全部 <span>{posts.length}</span></button>
      {types.map(([type, config]) => <button type="button" data-filter-kind="type" data-filter-value={type} aria-pressed="false">{config.label} <span>{countType(type)}</span></button>)}
    </div></fieldset>
    <fieldset><legend>标签</legend><div class="filter-chips">
      <button type="button" data-filter-kind="tag" data-filter-value="" aria-pressed="true">全部 <span>{posts.length}</span></button>
      {tags.map((tag) => <button type="button" data-filter-kind="tag" data-filter-value={tag} aria-pressed="false">{tag} <span>{countTag(tag)}</span></button>)}
    </div></fieldset>
    <p class="filter-result">显示 <strong data-filter-count>{posts.length}</strong> 篇内容</p>
  </section>
  <div class="archive-timeline" id="archive-results">
    {years.map((year) => <section data-archive-year>
      <div class="timeline-year">{String(year).slice(2)}</div>
      <h2>{year}</h2>
      <div class="timeline-list">
        {posts.filter((post) => post.data.publishedAt.getFullYear() === year).map((post) => <a href={`/posts/${post.id}/`} data-archive-entry data-type={post.data.type} data-tags={post.data.tags.join('|')}>
          <time>{formatDate(post.data.publishedAt)}</time><span><strong>{post.data.title}</strong><small>{post.data.description}</small></span>
        </a>)}
      </div>
    </section>)}
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive-filter-root]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-kind]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-archive-entry]')];
  const years = [...document.querySelectorAll<HTMLElement>('[data-archive-year]')];
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const state = { type: '', tag: '' };
  const apply = () => {
    let visible = 0;
    entries.forEach((entry) => {
      const matchesType = !state.type || entry.dataset.type === state.type;
      const matchesTag = !state.tag || entry.dataset.tags?.split('|').includes(state.tag);
      entry.hidden = !(matchesType && matchesTag);
      if (!entry.hidden) visible++;
    });
    years.forEach((year) => { year.hidden = !year.querySelector('[data-archive-entry]:not([hidden])'); });
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(state[button.dataset.filterKind as 'type' | 'tag'] === (button.dataset.filterValue ?? ''))));
    if (count) count.textContent = String(visible);
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    const kind = button.dataset.filterKind as 'type' | 'tag';
    state[kind] = button.dataset.filterValue ?? '';
    const url = new URL(location.href);
    state.type ? url.searchParams.set('type', state.type) : url.searchParams.delete('type');
    state.tag ? url.searchParams.set('tag', state.tag) : url.searchParams.delete('tag');
    history.pushState({}, '', url);
    apply();
  }));
  const params = new URLSearchParams(location.search);
  state.type = params.get('type') ?? '';
  state.tag = params.get('tag') ?? '';
  apply();
  if (root) root.hidden = false;
</script>
