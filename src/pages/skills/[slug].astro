---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const skills = await getCollection('skills', ({ data }) => !data.draft);
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }));
}
const { skill } = Astro.props;
const { Content } = await render(skill);
---

<BaseLayout title={skill.data.title} description={skill.data.description}>
  <article class="page-intro prose">
    <p class="eyebrow">SKILL · v{skill.data.version}</p>
    <h1>{skill.data.title}</h1>
    <p class="lede">{skill.data.description}</p>
    <p><a href={skill.data.downloadUrl} download>下载 Skill ↓</a></p>
    <p>SHA-256：<code>{skill.data.sha256}</code><br />许可：{skill.data.license} · 发布于 {formatDate(skill.data.publishedAt)}</p>
    <Content />
  </article>
</BaseLayout>
