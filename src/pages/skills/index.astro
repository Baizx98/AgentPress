---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedSkills, formatDate } from '../../lib/content';
const skills = await publishedSkills();
---

<BaseLayout title="Agent Skills" description="可下载的个人 Agent Skills">
  <section class="page-intro"><p class="eyebrow">AGENT SKILLS</p><h1>Agent Skills</h1><p class="lede">供 Agent 复用、带版本与校验信息的个人技能包。</p></section>
  {skills.map((skill) => (
    <article class="skill-card">
      <div>
        <p class="eyebrow">AGENT SKILL · v{skill.data.version}</p>
        <h2><a href={`/skills/${skill.id}/`}>{skill.data.title}</a></h2>
        <p>{skill.data.description}</p>
        <p>发布于 {formatDate(skill.data.publishedAt)} · {skill.data.license}</p>
      </div>
      <div class="skill-actions">
        <a href={`/skills/${skill.id}/`}>说明</a>
        <a class="button" href={skill.data.downloadUrl} download>下载</a>
      </div>
    </article>
  ))}
</BaseLayout>
