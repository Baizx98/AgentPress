---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getReadingStats } from '../../lib/content';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const reading = getReadingStats(post.body ?? '');
const typeLabel = data.type === 'paper' ? 'Paper' : data.type === 'technical-report' ? 'Report' : data.type === 'blog' ? data.series === 'daily-brief' ? 'Daily Brief' : 'Blog' : 'Note';
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const compactToc = tocHeadings.length > 0 && tocHeadings.length <= 3;
---

<BaseLayout title={data.title} description={data.description}>
  <div class:list={['article-layout', { 'article-layout--compact-toc': compactToc }]}>
    <article class="article-content prose">
      {data.cover && <img class="article-cover" src={data.cover} alt={data.title} loading="eager" />}
      <header class="article-header">
        <p class="eyebrow">{typeLabel}</p>
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>
        <p class="article-meta">{formatDate(data.publishedAt)} · {reading.count} 字 · 约 {reading.minutes} 分钟</p>
        {data.tags.length > 0 && <nav class="article-tags" aria-label="文章标签">
          {data.tags.map((tag) => <a href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
        </nav>}
      </header>
      {data.type === 'paper' && <p><strong>{data.paperTitle}</strong><br />{data.authors.join(', ')}<br />{data.affiliations.join(' · ')} · {data.venue}</p>}
      {data.type === 'technical-report' && data.repository && <p><a href={data.repository}>查看开源仓库 ↗</a></p>}
      <Content />
      <Giscus />
    </article>
    {tocHeadings.length > 0 && <aside class:list={['article-side', { 'article-side--compact': compactToc }]} aria-label="文章大纲">
      <nav class:list={['toc', 'toc-rail', { 'toc-rail--compact': compactToc }]}>
        {tocHeadings.map((heading, index) => <a class:list={{ 'toc-sub': heading.depth > 2 }} href={`#${heading.slug}`} aria-label={heading.text} style={`--toc-delay: ${index * 80}ms`}><span></span><em>{heading.text}</em></a>)}
      </nav>
    </aside>}
  </div>
</BaseLayout>
