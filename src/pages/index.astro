---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts } from '../lib/content';

const posts = await publishedPosts();
const featured = posts.filter((post) => post.data.featured);
const latest = posts.filter((post) => !post.data.featured).slice(0, 6);
---

<BaseLayout title="今夜白的知识宫殿" description="白卓新的 Agent-native 个人知识中心">
  <div class="content-shell home-layout">
    <aside class="identity-rail">
      <div class="avatar-placeholder" aria-hidden="true"></div>
      <p class="identity-name">白卓新</p>
      <p class="identity-role">LLM Inference Systems<br />Chongqing University</p>
      <a href="/about/">了解更多 →</a>
    </aside>
    <div class="home-feed">
      <section class="hero">
        <p class="eyebrow">PERSONAL KNOWLEDGE CENTER</p>
        <h1>今夜白的<br />知识宫殿</h1>
        <p class="lede">记录推理系统，也记录正在形成的想法。</p>
      </section>
      {featured.length > 0 && <section>
        <div class="section-head"><h2>Featured</h2></div>
        <div class="post-list">{featured.map((post) => <PostCard post={post} />)}</div>
      </section>}
      <section>
        <div class="section-head"><h2>Latest</h2><a href="/archive/">全部归档 →</a></div>
        <div class="post-list">{latest.map((post) => <PostCard post={post} />)}</div>
      </section>
    </div>
    <aside class="context-rail">
      <p class="eyebrow">FOCUS</p>
      <p>LLM Inference<br />KV Cache<br />Agent Memory</p>
      <p class="eyebrow">EXPLORE</p>
      <a href="/feed.xml">RSS Feed</a>
      <a href="/llms.txt">For Agents</a>
      <a href="/preview/">Article Preview</a>
    </aside>
  </div>
</BaseLayout>
