---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { publishedPosts } from '../lib/content';
import { siteConfig } from '../config/site';

const posts = await publishedPosts();
const latest = posts.slice(0, 5);
---
<BaseLayout>
  <section class="profile-card">
    <img src={siteConfig.author.avatar} alt="头像占位图" />
    <div class="profile-copy">
      <h1>{siteConfig.shortName}</h1>
      <p class="profile-title">{siteConfig.author.title}</p>
      <p class="profile-description">{siteConfig.author.description}</p>
    </div>
    <div class="profile-topics">{siteConfig.author.topics.map((topic) => <span>{topic}</span>)}</div>
    <div class="profile-social">
      {siteConfig.author.social.map((item) => <a href={item.href} title={item.label} aria-label={item.label}><Icon name={item.icon as 'github' | 'mail' | 'home' | 'orcid'} /><span>{item.label}</span></a>)}
    </div>
  </section>
  <section class="home-section">
    <div class="section-heading"><h2>最近文章</h2><a href="/posts/">查看全部 →</a></div>
    <div class="entry-list entry-list--home">{latest.map((post) => <PostCard post={post} variant="home" />)}</div>
  </section>
</BaseLayout>
